bond_data <-
tibble(
ytm = ytm,
bond1 = map_dbl(ytm, ZeroCouponBondPrice1),
bond2 = map_dbl(ytm, BondPrice1)
)
bond_data |>
pivot_longer(-ytm) |>
ggplot(aes(x = ytm, y = value, color = name)) +
geom_point() +
labs(
title = "bond price vs. ytm",
x = "yield to maturity",
y = "price of a bond"
) +
theme_bw()
